{
  "name": "freelance-manager",
  "version": "1.0.0",
  "description": "Private Freelance Business Management System — Vishal Prasad",
  "main": "server/index.js",
  "type": "module",
  "scripts": {
    "dev": "node --watch server/index.js",
    "build": "node scripts/build.js",
    "postinstall": "prisma generate || true",
    "start": "node scripts/build.js && node server/index.js",
    "db:generate": "npx prisma generate",
    "db:migrate": "npx prisma migrate dev",
    "db:push": "npx prisma db push",
    "db:seed": "node prisma/seed.js",
    "db:studio": "npx prisma studio",
    "test": "node --test tests/**/*.test.js"
  },
  "keywords": ["freelance", "business-management", "invoicing"],
  "author": "Vishal Prasad",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.2.0",
    "bcrypt": "^5.1.1",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "express-session": "^1.18.0",
    "helmet": "^8.0.0",
    "multer": "^1.4.5-lts.1",
    "puppeteer": "^23.0.0"
  },
  "devDependencies": {
    "prisma": "^6.2.0"
  }
}
